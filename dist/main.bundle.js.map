export default "// Vertex shader\nstruct Uniforms {\n    view_project_mat: mat4x4<f32>\n    , model_mat: mat4x4<f32>\n    , normal_mat: mat4x4<f32>\n}\n\n@binding(0) @group(0) var<uniform> uniforms: Uniforms;\n\nstruct Input {\n    @location(0) pos: vec4<f32>\n    , @location(1) normal: vec4<f32>\n    , @location(2) color: vec3<f32>\n}\n\nstruct Output {\n    @builtin(position) position: vec4<f32>\n    , @location(0) v_position: vec4<f32>\n    , @location(1) v_normal: vec4<f32>\n    , @location(2) v_color: vec3<f32>\n}\n\n@vertex\nfn vs_main(in: Input) -> Output {\n    var output: Output;\n    let m_position: vec4<f32> = uniforms.model_mat * in.pos;\n\n    output.v_position = m_position;\n    output.v_normal = uniforms.normal_mat * in.normal;\n    output.position = uniforms.view_project_mat * m_position;\n    output.v_color = in.color;\n\n    return output;\n}\n\n// Fragment shader\nstruct FragUniforms {\n    light_position: vec4<f32>   // ambient_intensity, diffuse_intensity, specular_intensity, specular_shininess\n    , eye_position: vec4<f32>   // is _two_side\n}\n\n@binding(1) @group(0) var<uniform> frag_uniforms: FragUniforms;\n\nstruct LightUniforms {\n    specular_color: vec4<f32>\n    , params: vec4<f32>\n    , param2: vec4<f32>\n}\n\n@binding(2) @group(0) var<uniform> light_uniforms: LightUniforms;\n\n@fragment\nfn fs_main(in: Output) -> @location(0) vec4<f32> {\n    let N: vec3<f32> = normalize(in.v_normal.xyz);\n\n    let L: vec3<f32> = normalize(\n        frag_uniforms.light_position.xyz - in.v_position.xyz\n    );\n\n    let V: vec3<f32> = normalize(\n        frag_uniforms.eye_position.xyz - in.v_position.xyz\n    );\n\n    let H: vec3<f32> = normalize(L + V);\n\n    // Front side\n    var diffuse: f32 = light_uniforms.params[1] * max(dot(N, L), 0.0);\n\n    var specular: f32 = light_uniforms.params[2]\n        * pow(max(dot(N, H), 0.0), light_uniforms.params[3]);\n\n    // Back side\n    if(i32(light_uniforms.param2[0]) == 1) {\n        diffuse = diffuse + light_uniforms.params[1] * max(dot(-N, L), 0.0);\n\n        specular = specular + light_uniforms.params[2]\n            * pow(max(dot(-N, H), 0.0), light_uniforms.params[3]);\n    }\n\n    let ambient: f32 = light_uniforms.params[0];\n\n    let final_color = in.v_color\n        * (ambient + diffuse)\n        + light_uniforms.specular_color.rgb\n        * specular;\n\n    return vec4<f32>(final_color.rgb, 1.0);\n}"